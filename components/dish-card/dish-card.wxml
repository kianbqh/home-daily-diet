<view class="dish-card {{selected ? 'selected' : ''}}" bindtap="onTap">
  <view class="dish-media">
    <image wx:if="{{displayDish.hasImage}}" src="{{displayDish.coverImage}}" mode="aspectFill" />
    <view wx:else class="dish-placeholder">
      <text class="placeholder-icon">🥢</text>
      <text class="placeholder-initial">{{displayDish.placeholder}}</text>
    </view>
    <view wx:if="{{selected}}" class="selected-mark">✓</view>
  </view>
  <view class="dish-content">
    <text class="dish-name">{{displayDish.name}}</text>
    <view class="dish-meta">
      <text>{{displayDish.recordCount || 0}} 次记录</text>
      <text>{{displayDish.latestRecordLabel}}</text>
      <text>{{displayDish.ratingLabel || '暂无评价'}}</text>
    </view>
  </view>
</view>
