<view class="recipe-editor">
  <view class="editor-section card-surface">
    <view class="editor-heading">
      <view>
        <view class="section-title">食材与用量</view>
        <text class="section-note">写清食材、用量和需要注意的处理方式</text>
      </view>
      <button class="editor-add" bindtap="addIngredient">添加食材</button>
    </view>
    <view wx:if="{{!recipe.ingredients.length}}" class="editor-empty">还没有食材</view>
    <view wx:for="{{recipe.ingredients}}" wx:key="index" class="editor-item">
      <view class="item-topline">
        <text class="item-number">食材 {{index + 1}}</text>
        <text class="remove-action" data-index="{{index}}" bindtap="removeIngredient">删除</text>
      </view>
      <input class="visible-native-input" maxlength="1000" value="{{item.name}}" placeholder="食材名称（必填）" data-index="{{index}}" data-field="name" bindinput="onIngredientInput" />
      <view class="input-gap"></view>
      <input class="visible-native-input" maxlength="1000" value="{{item.amountText}}" placeholder="用量，例如：2 个、少许" data-index="{{index}}" data-field="amountText" bindinput="onIngredientInput" />
      <view class="input-gap"></view>
      <textarea class="visible-native-textarea" maxlength="1000" auto-height value="{{item.note}}" placeholder="处理说明，例如：去皮切块" data-index="{{index}}" data-field="note" bindinput="onIngredientInput" />
    </view>
  </view>

  <view class="editor-section card-surface">
    <view class="editor-heading">
      <view>
        <view class="section-title">制作步骤</view>
        <text class="section-note">按实际顺序记录火候、时间和关键点</text>
      </view>
      <button class="editor-add" bindtap="addStep">添加步骤</button>
    </view>
    <view wx:if="{{!recipe.steps.length}}" class="editor-empty">还没有制作步骤</view>
    <view wx:for="{{recipe.steps}}" wx:key="order" class="editor-item">
      <view class="item-topline">
        <text class="item-number">第 {{index + 1}} 步</text>
        <text class="remove-action" data-index="{{index}}" bindtap="removeStep">删除</text>
      </view>
      <textarea class="visible-native-textarea" maxlength="1000" auto-height value="{{item.instruction}}" placeholder="这一步怎么做（必填）" data-index="{{index}}" data-field="instruction" bindinput="onStepInput" />
      <view class="two-column">
        <input class="visible-native-input" maxlength="1000" value="{{item.heat}}" placeholder="火候" data-index="{{index}}" data-field="heat" bindinput="onStepInput" />
        <input class="visible-native-input" maxlength="1000" value="{{item.durationText}}" placeholder="时间" data-index="{{index}}" data-field="durationText" bindinput="onStepInput" />
      </view>
      <textarea class="visible-native-textarea input-gap" maxlength="1000" auto-height value="{{item.keyPoint}}" placeholder="关键点" data-index="{{index}}" data-field="keyPoint" bindinput="onStepInput" />
    </view>
  </view>

  <view class="editor-section card-surface">
    <view class="editor-heading">
      <view>
        <view class="section-title">技巧</view>
        <text class="section-note">容易忽略但会影响成品的小技巧</text>
      </view>
      <button class="editor-add" data-field="tips" bindtap="addTextItem">添加技巧</button>
    </view>
    <view wx:for="{{recipe.tips}}" wx:key="index" class="compact-item">
      <textarea class="visible-native-textarea" maxlength="1000" auto-height value="{{item}}" placeholder="写下一条技巧" data-index="{{index}}" data-field="tips" bindinput="onTextItemInput" />
      <text class="remove-action compact-remove" data-index="{{index}}" data-field="tips" bindtap="removeTextItem">删除</text>
    </view>
  </view>

  <view class="editor-section card-surface">
    <view class="editor-heading">
      <view>
        <view class="section-title">常见失败与补救</view>
        <text class="section-note">记录问题、原因和下次怎么补救</text>
      </view>
      <button class="editor-add" bindtap="addFailure">添加问题</button>
    </view>
    <view wx:for="{{recipe.failures}}" wx:key="index" class="editor-item">
      <view class="item-topline">
        <text class="item-number">问题 {{index + 1}}</text>
        <text class="remove-action" data-index="{{index}}" bindtap="removeFailure">删除</text>
      </view>
      <textarea class="visible-native-textarea" maxlength="1000" auto-height value="{{item.problem}}" placeholder="遇到了什么问题" data-index="{{index}}" data-field="problem" bindinput="onFailureInput" />
      <textarea class="visible-native-textarea input-gap" maxlength="1000" auto-height value="{{item.cause}}" placeholder="可能原因" data-index="{{index}}" data-field="cause" bindinput="onFailureInput" />
      <textarea class="visible-native-textarea input-gap" maxlength="1000" auto-height value="{{item.remedy}}" placeholder="补救方式" data-index="{{index}}" data-field="remedy" bindinput="onFailureInput" />
    </view>
  </view>

  <view class="editor-section card-surface">
    <view class="editor-heading">
      <view>
        <view class="section-title">家庭经验</view>
        <text class="section-note">只属于你们家的口味和经验</text>
      </view>
      <button class="editor-add" data-field="familyNotes" bindtap="addTextItem">添加经验</button>
    </view>
    <view wx:for="{{recipe.familyNotes}}" wx:key="index" class="compact-item">
      <textarea class="visible-native-textarea" maxlength="1000" auto-height value="{{item}}" placeholder="写下一条家庭经验" data-index="{{index}}" data-field="familyNotes" bindinput="onTextItemInput" />
      <text class="remove-action compact-remove" data-index="{{index}}" data-field="familyNotes" bindtap="removeTextItem">删除</text>
    </view>
  </view>

  <view wx:if="{{recipe.uncertainties.length}}" class="editor-section uncertainty-card">
    <view class="section-title">需要确认</view>
    <view wx:for="{{recipe.uncertainties}}" wx:key="fieldPath" class="uncertainty-item">{{item.message}}</view>
  </view>
</view>
