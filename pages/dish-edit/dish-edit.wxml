<view class="page edit-page">
  <view class="eyebrow">KEEP THE MEMORY</view>
  <view class="page-title">{{isEditingProfile ? '编辑菜品信息' : (isExisting ? '再记录一次' : '记录一道菜')}}</view>
  <view class="page-subtitle">{{isEditingProfile ? '修改菜名、标签或封面，不会影响之前的制作记录。' : '菜名必填，图片和餐次可以慢慢补充。'}}</view>

  <view wx:if="{{isExisting && history.length}}" class="card-surface history-section">
    <view class="section-title">制作记录（{{history.length}} 次）</view>
    <view wx:for="{{history}}" wx:key="id" class="history-item">
      <view class="history-top">
        <text>{{item.recordDateLabel}}</text>
        <text>{{item.mealLabel}}</text>
      </view>
      <view class="history-body">
        <image wx:if="{{item.image}}" class="history-image" src="{{item.image}}" mode="aspectFill" />
        <view wx:else class="history-placeholder">🍽</view>
      </view>
    </view>
  </view>

  <view class="card-surface form-section">
    <text class="form-label">菜名 <text class="required">*</text></text>
    <view class="text-input-shell {{isExisting && !isEditingProfile ? 'readonly' : ''}}">
      <text wx:if="{{nameDraft}}" class="input-visible">{{nameDraft}}</text>
      <text wx:else class="input-visible input-placeholder">例如：番茄炒蛋</text>
      <input class="input-capture" value="{{nameDraft}}" disabled="{{isExisting && !isEditingProfile}}" placeholder-class="input-placeholder" bindfocus="onNameFocus" bindinput="onNameInput" bindblur="onNameBlur" />
    </view>
  </view>

  <view class="card-surface form-section">
    <text class="form-label">{{isEditingProfile ? '菜品封面' : '这次的照片'}} <text class="optional">可选</text></text>
    <view class="image-picker" bindtap="chooseImage">
      <image wx:if="{{displayImage}}" src="{{displayImage}}" mode="aspectFill" />
      <view wx:else class="image-picker-placeholder">
        <text class="image-picker-icon">📷</text>
        <text>{{isEditingProfile ? '补一张代表这道菜的照片' : '拍一张或从相册选择'}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!isExisting || isEditingProfile}}" class="card-surface form-section">
    <text class="form-label">标签 <text class="optional">可选</text></text>
    <view class="text-input-shell">
      <text wx:if="{{tagsDraft}}" class="input-visible">{{tagsDraft}}</text>
      <text wx:else class="input-visible input-placeholder">例如：家常、素菜、下饭</text>
      <input class="input-capture" value="{{tagsDraft}}" placeholder-class="input-placeholder" bindfocus="onTagsFocus" bindinput="onTagsInput" bindblur="onTagsBlur" />
    </view>
  </view>

  <block wx:if="{{!isEditingProfile}}">
    <view class="card-surface form-section">
      <text class="form-label">记录日期</text>
      <picker mode="date" value="{{recordDate}}" bindchange="onRecordDateChange">
        <view class="picker-field date-field">{{recordDate}} <text class="picker-arrow">⌄</text></view>
      </picker>
      <text class="form-label sub-label">餐次 <text class="optional">可选</text></text>
      <picker mode="selector" range="{{mealTypes}}" range-key="label" bindchange="chooseMealType">
        <view class="picker-field">{{mealTypeLabel}} <text class="picker-arrow">⌄</text></view>
      </picker>
      <view wx:if="{{mealType === 'custom'}}" class="text-input-shell sub-input">
        <text wx:if="{{customMealTypeDraft}}" class="input-visible">{{customMealTypeDraft}}</text>
        <text wx:else class="input-visible input-placeholder">例如：周末聚餐</text>
        <input class="input-capture" value="{{customMealTypeDraft}}" placeholder-class="input-placeholder" bindfocus="onCustomMealTypeFocus" bindinput="onCustomMealTypeInput" bindblur="onCustomMealTypeBlur" />
      </view>
    </view>
  </block>

  <view class="sticky-action">
    <button class="primary-button" bindtap="save">{{isEditingProfile ? '保存菜品信息' : (isExisting ? '保存这次记录' : '保存这道菜')}}</button>
  </view>
</view>
