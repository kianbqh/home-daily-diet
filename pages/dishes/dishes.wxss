.dishes-page .page-header {
  display: block;
}

.dishes-page .page-title {
  white-space: nowrap;
}

.library-header-actions {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-top: 24rpx;
}

.library-header-actions button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 26rpx;
  line-height: 1.2;
}

.header-trash {
  background: #ede9df;
  color: #315b49;
}

.header-add {
  background: #315b49;
  color: #fff;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 34rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f0ede6;
}

.search-icon {
  color: #8a8e84;
  font-size: 38rpx;
}

.search-box input {
  flex: 1;
  height: 84rpx;
  color: #353a34;
  font-size: 27rpx;
}

.search-input-shell {
  position: relative;
  flex: 1;
  height: 84rpx;
  min-width: 0;
}

.search-input-visible {
  min-height: 84rpx;
  padding: 0;
  color: #353a34;
  font-size: 27rpx;
  line-height: 84rpx;
}

.search-input-capture {
  height: 84rpx;
  padding: 0;
  color: transparent;
  caret-color: transparent;
}

.search-box .search-input-capture {
  color: transparent;
  caret-color: transparent;
}

.search-clear {
  color: #315b49;
  font-size: 22rpx;
  white-space: nowrap;
}

.tag-scroll {
  margin-top: 22rpx;
  white-space: nowrap;
}

.tag-row {
  display: inline-flex;
  gap: 14rpx;
}

.tag {
  padding: 14rpx 22rpx;
  border-radius: 99rpx;
  background: #f0ede6;
  color: #777d74;
  font-size: 23rpx;
}

.tag.active {
  background: #315b49;
  color: #fff;
}

.library-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
  margin-top: 34rpx;
}

.library-empty {
  margin-top: 38rpx;
}

.back-button {
  margin: 28rpx auto 0;
}
