<view class="page recipe-page">
  <view class="eyebrow">FAMILY RECIPE</view>
  <view class="page-title">{{isHistorical ? '历史菜谱' : '家庭菜谱'}}</view>
  <view class="page-subtitle">{{isHistorical ? '这是已确认的只读版本。' : '家人共同确认的当前做法。'}}</view>

  <view wx:if="{{loading}}" class="card-surface state-card">正在读取菜谱…</view>
  <view wx:elif="{{error}}" class="card-surface state-card error-card">
    <view class="state-title">{{error}}</view>
    <text class="state-copy">{{unavailable ? '现有菜品、制作记录和评价仍可继续使用。' : '请稍后下拉刷新重试。'}}</text>
  </view>
  <view wx:elif="{{!version}}" class="empty-card">
    <view class="empty-icon">📖</view>
    <view class="empty-title">还没有家庭菜谱</view>
    <view class="empty-description">从菜品详情手动创建第一版做法。</view>
  </view>

  <block wx:else>
    <view class="card-surface recipe-meta-card">
      <view class="meta-counts">
        <view><text class="meta-number">{{summary.ingredientCount}}</text><text class="meta-label">种食材</text></view>
        <view><text class="meta-number">{{summary.stepCount}}</text><text class="meta-label">个步骤</text></view>
      </view>
      <view class="confirmed-meta">第 {{version.versionNumber}} 版 · {{version.confirmedByLabel}} · {{version.confirmedAtLabel}}</view>
      <button wx:if="{{!isHistorical}}" class="secondary-button edit-main-button" bindtap="editMainRecipe">编辑主菜谱</button>
    </view>

    <view class="card-surface recipe-section">
      <view class="section-title">食材与用量</view>
      <view wx:if="{{!recipe.ingredients.length}}" class="section-empty">没有记录</view>
      <view wx:for="{{recipe.ingredients}}" wx:key="index" class="ingredient-row">
        <view class="ingredient-main"><text class="ingredient-name">{{item.name}}</text><text class="ingredient-amount">{{item.amountText}}</text></view>
        <text wx:if="{{item.note}}" class="item-note">{{item.note}}</text>
      </view>
    </view>

    <view class="card-surface recipe-section">
      <view class="section-title">制作步骤</view>
      <view wx:if="{{!recipe.steps.length}}" class="section-empty">没有记录</view>
      <view wx:for="{{recipe.steps}}" wx:key="order" class="step-row">
        <view class="step-number">{{index + 1}}</view>
        <view class="step-content">
          <text class="step-instruction">{{item.instruction}}</text>
          <text wx:if="{{item.heat || item.durationText}}" class="step-meta">{{item.heat}} {{item.durationText}}</text>
          <text wx:if="{{item.keyPoint}}" class="item-note">关键点：{{item.keyPoint}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{recipe.tips.length}}" class="card-surface recipe-section">
      <view class="section-title">技巧</view>
      <text wx:for="{{recipe.tips}}" wx:key="index" class="bullet-item">• {{item}}</text>
    </view>

    <view wx:if="{{recipe.failures.length}}" class="card-surface recipe-section">
      <view class="section-title">常见失败与补救</view>
      <view wx:for="{{recipe.failures}}" wx:key="index" class="failure-item">
        <text class="failure-title">{{item.problem}}</text>
        <text wx:if="{{item.cause}}" class="item-note">原因：{{item.cause}}</text>
        <text wx:if="{{item.remedy}}" class="item-note">补救：{{item.remedy}}</text>
      </view>
    </view>

    <view wx:if="{{recipe.familyNotes.length}}" class="card-surface recipe-section">
      <view class="section-title">家庭经验</view>
      <text wx:for="{{recipe.familyNotes}}" wx:key="index" class="bullet-item">• {{item}}</text>
    </view>
  </block>

  <view wx:if="{{versions.length}}" class="card-surface history-version-section">
    <view class="section-heading compact-heading">
      <view class="section-title">历史版本</view>
      <text class="section-count">{{versions.length}} 版</text>
    </view>
    <view wx:for="{{versions}}" wx:key="_id" class="version-row" data-version-id="{{item._id}}" bindtap="openVersion">
      <view>
        <text class="version-title">第 {{item.versionNumber}} 版</text>
        <text class="version-meta">{{item.confirmedByLabel}} · {{item.confirmedAtLabel}}</text>
      </view>
      <text class="version-arrow">›</text>
    </view>
  </view>
</view>
